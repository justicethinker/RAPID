{
  "name": "rapid",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.app.json",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "e2e:auth": "playwright test --config playwright.auth.config.ts",
    "e2e:all": "pnpm e2e && pnpm e2e:auth",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed-dev.mjs",
    "logo": "node scripts/process-logo.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.1",
    "@clerk/clerk-react": "^5.61.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vercel/node": "^27.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
