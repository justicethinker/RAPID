# RAPID environment variables
# Copy this file to .env.local and fill in the values. Never commit .env.local.

# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------

# Public site origin used for canonical links, Open Graph tags and the privacy page.
# Defaults to the current Vercel URL when unset.
VITE_SITE_URL=https://rapid.africa

# Approved support address shown in the footer, confirmations and privacy page.
VITE_CONTACT_EMAIL=

# Privacy-friendly analytics. Leave unset to disable analytics entirely.
VITE_PLAUSIBLE_DOMAIN=
# Override only for a self-hosted Plausible script.
VITE_PLAUSIBLE_SRC=

# ---------------------------------------------------------------------------
# Accounts (browser)
# ---------------------------------------------------------------------------

# Clerk publishable key. Without it the site runs as a public brochure and the
# authenticated routes explain that sign-in is not configured.
VITE_CLERK_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# API (server only — never prefix these with VITE_)
# ---------------------------------------------------------------------------

# Postgres connection string. Neon in production; any Postgres locally.
DATABASE_URL=postgresql://rapid:rapid@localhost:5433/rapid

# Clerk secret key. Required to verify session tokens.
CLERK_SECRET_KEY=

# Transactional email. Without a key, messages are captured in the server log
# and recorded in email_log; nothing is sent. Addresses at @rapid.invalid and
# .rapid.local are always suppressed.
RESEND_API_KEY=
# Sender identity. The sending domain must be verified in Resend.
EMAIL_FROM=RAPID <hello@rapid.africa>

# Comma-separated addresses that always hold staff (admin) access. This is how
# the first admin is bootstrapped; every later admin is invited from /staff/team.
STAFF_EMAILS=

# Local-only role sign-in for developing the dashboards without Clerk users.
# Ignored when VERCEL_ENV=production. Never enable this on a public deployment.
ALLOW_DEV_AUTH=1
# Signs the local session cookie. Any long random string; local use only.
DEV_AUTH_SECRET=
# Credentials for the local admin door at /admin/sign-in. They are only accepted
# while ALLOW_DEV_AUTH=1 outside production, so a deployed pilot refuses them.
# Change both before sharing a machine.
ADMIN_SIGN_IN_USERNAME=admin
ADMIN_SIGN_IN_PASSWORD=admin

# ---------------------------------------------------------------------------
# Legacy pilot integration (retired once the sheet is read-only)
# ---------------------------------------------------------------------------

# Google Apps Script web-app /exec URL from integrations/google-apps-script.
VITE_SUBMISSIONS_ENDPOINT=

# ---------------------------------------------------------------------------
# AI and payments (server only — never prefix these with VITE_)
# ---------------------------------------------------------------------------

# Optional server-only AI key for guided intake, study drafts and findings drafts.
# Leave empty to run the deterministic manual fallback.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-6-luna
AI_ESCALATION_MODEL=gpt-6.1-sol

# Paystack server secret. Configure the webhook endpoint at /api/payments/paystack/webhook.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
TASK_LINK_SECRET=
